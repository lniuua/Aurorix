{
  "port": 8080,
  "appid": "你的机器人AppID",
  "secret": "你的机器人AppSecret",
  "proxy": "https://api.bot.qq.com",
  "gateway_url": "",
  "protocol": "webhook",
  "intents": [
    "GROUP_AT_MESSAGE_CREATE",
    "GROUP_MESSAGE_CREATE",
    "C2C_MESSAGE_CREATE",
    "INTERACTION_CREATE",
    "GROUP_MEMBER_ADD",
    "GROUP_MEMBER_REMOVE",
    "MESSAGE_AUDIT_PASS",
    "MESSAGE_AUDIT_REJECT"
  ],
  "database": "bot.db",
  "admin_password": "123456",
  "global_markdown": false,
  "image_limits_enabled": true,
  "image_max_width": 350,
  "image_max_height": 438,
  "retry_when": [11253, 630006],
  "upload_threshold": 3145728,
  "log_level": "info",
  "owners": [],
  "access": {
    "group_mode": "off",
    "user_mode": "off",
    "groups": [],
    "users": []
  },
  "footer_buttons_enabled": true,
  "footer_buttons": [
    "+1 | repeat",
    "帮助 | command | /help",
    "文档 | link | https://example.com/docs , 使用说明 | image | https://example.com/guide.png"
  ],
  "plugin_settings": {
    "imagegen": {
      "base_url": "https://api.openai.com/v1",
      "api_key": "你的API密钥",
      "model_id": "gpt-image-1"
    }
  },
  "plugin_access": {
    "echo": {
      "default": { "mode": "off" },
      "commands": {
        "/random": { "mode": "off" },
        "/uid": { "mode": "off" }
      }
    },
    "uptime": {
      "default": { "mode": "off" },
      "commands": {
        "/uptime": { "mode": "off" },
        "/openai": { "mode": "off" }
      }
    },
    "bind": {
      "default": { "mode": "off" }
    },
    "imagegen": {
      "default": { "mode": "off" }
    }
  }
}
